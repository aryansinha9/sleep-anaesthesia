# ─── Site ────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap, Open Graph and schema.org.
NEXT_PUBLIC_SITE_URL=https://sleepanaesthesia.com.au

# ─── Supabase ────────────────────────────────────────────────────────────
# Leave these blank to run the public site from the seed content in
# src/content/seed (the admin dashboard is disabled until they are set).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: Row Level Security
# limits it to reading published content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for: sending admin
# invitations, processing uploads, storing enquiries, login rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin sessions ──────────────────────────────────────────────────────
# Minutes of inactivity before an admin is signed out (default 30).
ADMIN_IDLE_TIMEOUT_MINUTES=30

# ─── Enquiry form delivery (optional) ────────────────────────────────────
# Enquiries are always stored in Supabase (Admin → Enquiries). Set these to
# also receive each enquiry by email through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=admin@sleepanaesthesia.com.au
ENQUIRY_FROM_EMAIL=Sleep Anaesthesia <website@sleepanaesthesia.com.au>
